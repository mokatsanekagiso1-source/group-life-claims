# Copy to infra/.env to override the defaults in docker-compose.yml.
# Local development values only; never commit a real .env.
POSTGRES_DB=grouplife
POSTGRES_USER=grouplife
POSTGRES_PASSWORD=change-me

# "dev" seeds synthetic demo data. Use "default" for an empty database.
SPRING_PROFILES_ACTIVE=dev
# Required outside the dev profile: at least 32 random characters.
JWT_SECRET=
# Optional: creates an "admin" user with this password when no admin exists.
BOOTSTRAP_ADMIN_PASSWORD=

GRAFANA_ADMIN_PASSWORD=change-me

DB_PORT=5432
API_PORT=8080
WEB_PORT=4200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
